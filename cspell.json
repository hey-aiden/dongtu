{
	"version": "0.2",
	"language": "en",
	"caseSensitive": false,
	"words": [
		"uv",
		"dongtu",
		"autoflush",
		"sessionmaker",
		"ondelete",
		"deepseek",
		"ainvoke"
	],
	"ignoreWords": [],
	"ignorePaths": [
		".venv/**",
